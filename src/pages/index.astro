---
import Layout from "@layouts/Layout.astro";
import HomeNav from "@components/HomeNav.astro";
import HomeFooter from "@components/HomeFooter.astro";
import Arrow from "@components/Arrow.astro";
import HomeHeroVideo from "@components/HomeHeroVideo.astro";
import HomeGallery from "@components/HomeGallery.astro";
import HomeSpeakers from "@components/HomeSpeakers.astro";
import PastSponsors from "@components/PastSponsors.astro";
import TestimonialsSection from "@components/TestimonialsSection.astro";
import { getEventConfig } from "@shared/data/events";
// A stand-in photo until the one in the Figma mockup is added: the hero
// video's poster.
import heroPhoto from "@assets/images/cjs19-family-photo.jpg";

// The 2027 home page, built from the Figma "Home - laptop" frame.
const config = getEventConfig("2027");

// Sizes and spacing are the Figma "Home - laptop" frame's own values: a
// 1176px content column, 64px between sections, and Figma's "Auto" line
// height as CSS `normal`.
// The "What to Expect" figures.
const expectations = [
  { figure: "2", label: "Days" },
  { figure: "20+", label: "Speakers" },
  { figure: "4", label: "Workshops" },
  { figure: "2", label: "Parties" },
];

const container = "mx-auto box-content max-w-294 px-4";
const heading =
  "mt-0 mb-4 font-serif text-5xl leading-[0.95] font-semibold md:text-[72px]";
const eyebrow = "font-display m-0 leading-none font-light";
const body = "text-lg leading-[normal]";
const arrowLink =
  "text-sound-navy border-emerald-city-green hover:border-sound-navy inline-block border-b-3 pb-[3px] text-xl leading-[27px] font-bold no-underline";
---

<Layout
  title="CascadiaJS 2027 | June 7 - 8 | Seattle, WA"
  description={config.ogDescription}
  ogImage={config.ogImage}
  displayNav={false}
  displayAlert={false}
  background="mist"
>
  <div
    class="bg-mist text-sound-navy [&_a:focus-visible]:outline-sound-navy font-normal [&_a:focus-visible]:outline-2 [&_a:focus-visible]:outline-offset-2"
  >
    <header class={`${container} pt-10 pb-6`}>
      <div class="flex items-start justify-between gap-6">
        <a href="/" class="block max-w-[327px] min-w-0 flex-1">
          <img
            src="/images/cjs-lockup-blue.svg"
            alt="CascadiaJS"
            width="327"
            height="69"
            class="block h-auto w-full"
          />
        </a>
        <a
          href="/tickets"
          class="bg-emerald-city-green text-sound-navy shrink-0 rounded-[5px] px-8 py-2 font-sans text-xl leading-[27px] font-bold no-underline hover:bg-[color-mix(in_srgb,var(--color-emerald-city-green),white_20%)] hover:underline"
        >
          Tickets
        </a>
      </div>
      <div
        class="mt-8 flex flex-col gap-4 font-serif text-[24px] leading-[29px] font-medium md:mt-18 md:flex-row md:justify-between"
      >
        <h1
          class="text-sound-navy m-0 font-serif text-[24px] leading-[29px] font-medium"
        >
          A Web + AI conference for<br />the Pacific Northwest
        </h1>
        <p class="m-0 leading-[29px] md:text-right">
          June 7-8, 2027<br />Seattle Convention Center
        </p>
      </div>
    </header>

    <HomeHeroVideo
      src="/events/2027/video/hero.mp4"
      poster={heroPhoto}
      label="CascadiaJS attendees at the conference"
    />

    <HomeNav />

    {
      /* The conference at a glance, after circlesconference.com's "What to
         Expect" (without its visible heading; screen readers get it as the
         section's label): four big figures in a row, divided by thin rules
         (none before the first in each row), two by two on phones. Each
         figure is a dt/dd pair, shown figure first but read label first. */
    }
    <section
      id="what-to-expect"
      aria-label="What to Expect"
      class={`${container} pt-16`}
    >
      <dl class="m-0 grid grid-cols-2 gap-y-10 md:grid-cols-4">
        {
          expectations.map(({ figure, label }) => (
            <div class="border-sound-navy/15 flex flex-col-reverse border-l pl-5 first:border-l-0 first:pl-0 max-md:odd:border-l-0 max-md:odd:pl-0 md:pl-8">
              <dt class="font-display mt-3 text-lg leading-none font-light md:mt-5 md:text-2xl">
                {label}
              </dt>
              <dd class="font-display m-0 text-[72px] leading-[0.85] font-light md:text-[120px]">
                {figure}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <div class={`${container} pt-16`}>
      <hr class="border-sound-navy/10 m-0 border-t" />
    </div>

    <section
      id="cfp"
      class={`${container} pt-16 md:grid md:grid-cols-[600fr_111fr_367fr_98fr]`}
    >
      <HomeSpeakers />
      <div class="mt-8 md:col-start-3 md:mt-0">
        <p class={`${eyebrow} mb-4 text-lg`}>Call for presenters</p>
        <h2 class={heading}>Speak at CascadiaJS</h2>
        <p class={body}>
          Tell your story in front of the best conference audience around.
          <strong class="font-semibold">Submit by Jan 10, 2027.</strong>
        </p>
        <a href="https://cfp.cascadiajs.com" class={arrowLink}>
          Apply to speak <Arrow />
        </a>
      </div>
    </section>

    <div class={`${container} pt-16`}>
      <hr class="border-sound-navy/10 m-0 border-t" />
    </div>

    <section
      id="sponsor"
      class={`${container} pt-[65px] md:grid md:grid-cols-[367fr_209fr_593fr_7fr]`}
    >
      <div>
        <p class={`${eyebrow} mb-4 text-lg`}>Partner with us</p>
        <h2 class={heading}>Sponsor</h2>
        <p class={body}>
          <strong class="font-semibold">
            More face time. Better conversations.
          </strong>
          <br />
          CascadiaJS connects sponsors with 600+ developers who evaluate tools, share
          recommendations, and influence technology decisions at their organizations.
        </p>
        <a href="/sponsor" class={arrowLink}>See sponsor brochure <Arrow /></a>
      </div>
      <div class="mt-12 md:col-start-3 md:mt-0">
        <PastSponsors />
      </div>
    </section>

    <HomeGallery />

    <TestimonialsSection />
  </div>

  <HomeFooter slot="footer" />
</Layout>
