---
import Layout from "@layouts/Layout.astro";
import HomeNav from "@components/HomeNav.astro";
import HomeFooter from "@components/HomeFooter.astro";
import Arrow from "@components/Arrow.astro";
import HomeHeroVideo from "@components/HomeHeroVideo.astro";
import HomeGallery from "@components/HomeGallery.astro";
import Testimonials from "@components/Testimonials.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getCollection } from "astro:content";
import { getEventConfig } from "@shared/data/events";
import testimonialsData from "@shared/data/testimonials.json";
import speakerPhoto from "@assets/images/home-cfp.jpg";
// A stand-in photo until the one in the Figma mockup is added: the hero
// video's poster.
import heroPhoto from "@assets/images/cjs19-family-photo.jpg";

// The 2027 home page, built from the Figma "Home - laptop" frame.
const config = getEventConfig("2027");

// No 2027 Sponsors yet, so show the past Sponsors people in tech know best.
const PAST_SPONSOR_IDS = [
  "atlassian",
  "auth0",
  "aws",
  "bluesky",
  "circleci",
  "cloudflare",
  "datadog",
  "elastic",
  "github",
  "google",
  "langchain",
  "netlify",
  "new-relic",
  "postman",
  "pulumi",
  "retool",
  "salesforce-devs",
  "sentry",
  "tmobile",
  "twilio",
  "uber",
];
const pastSponsors = (await getCollection("sponsors"))
  .map((entry) => entry.data)
  .filter((sponsor) => PAST_SPONSOR_IDS.includes(sponsor.id))
  .sort((a, b) => a.name.localeCompare(b.name));
const sponsorImages = import.meta.glob<{ default: ImageMetadata }>(
  "@assets/images/sponsors/*.{jpg,png,svg,jpeg}",
  { eager: false, base: "/src/assets/images/sponsors" },
);
// The logos run left, centre, right across each row of three.
const sponsorAlign = ["justify-start", "justify-center", "justify-end"];

const testimonials = testimonialsData.slice(0, 4);

// Sizes and spacing are the Figma "Home - laptop" frame's own values: a
// 1176px content column, 64px between sections, and Figma's "Auto" line
// height as CSS `normal`.
const container = "mx-auto box-content max-w-294 px-4";
const heading =
  "mt-0 mb-4 font-serif text-5xl leading-[0.95] font-semibold md:text-[72px]";
const eyebrow = "font-display m-0 leading-none font-light";
const body = "text-lg leading-[normal]";
const arrowLink =
  "text-sound-navy border-emerald-city-green hover:border-sound-navy inline-block border-b-3 pb-[3px] text-xl leading-[27px] font-bold no-underline";
---

<Layout
  title="CascadiaJS 2027 | June 7 - 8 | Seattle, WA"
  description={config.ogDescription}
  ogImage={config.ogImage}
  displayNav={false}
  displayAlert={false}
>
  <div
    class="bg-mist text-sound-navy [&_a:focus-visible]:outline-sound-navy font-normal [&_a:focus-visible]:outline-2 [&_a:focus-visible]:outline-offset-2"
  >
    <header class={`${container} pt-10 pb-6`}>
      <div class="flex items-start justify-between gap-6">
        <a href="/" class="block max-w-[327px] min-w-0 flex-1">
          <img
            src="/images/cjs-lockup-blue.svg"
            alt="CascadiaJS"
            width="327"
            height="69"
            class="block h-auto w-full"
          />
        </a>
        <a
          href="/tickets"
          class="bg-emerald-city-green text-sound-navy shrink-0 rounded-[5px] px-8 py-2 font-sans text-xl leading-[27px] font-bold no-underline hover:bg-[color-mix(in_srgb,var(--color-emerald-city-green),white_20%)] hover:underline"
        >
          Tickets
        </a>
      </div>
      <div
        class="mt-8 flex flex-col gap-4 font-serif text-[24px] leading-[29px] font-medium md:mt-18 md:flex-row md:justify-between"
      >
        <h1
          class="text-sound-navy m-0 font-serif text-[24px] leading-[29px] font-medium"
        >
          A Web + AI conference for<br />the Pacific Northwest
        </h1>
        <p class="m-0 leading-[29px] md:text-right">
          June 7-8, 2027<br />Seattle Convention Center
        </p>
      </div>
    </header>

    <HomeHeroVideo
      src="/events/2027/video/hero.mp4"
      poster={heroPhoto}
      label="CascadiaJS attendees at the conference"
    />

    <HomeNav />

    <section
      id="cfp"
      class={`${container} pt-16 md:grid md:grid-cols-[600fr_111fr_367fr_98fr]`}
    >
      <Image
        src={speakerPhoto}
        alt="A speaker on stage, seen from behind, facing a packed hall under arched stained-glass windows"
        widths={[600, 1200]}
        sizes="(min-width: 768px) 600px, 100vw"
        class="aspect-square w-full object-cover"
      />
      <div class="mt-8 md:col-start-3 md:mt-0">
        <p class={`${eyebrow} mb-4 text-lg`}>Call for presenters</p>
        <h2 class={heading}>Speak at CascadiaJS</h2>
        <p class={body}>
          Tell your story in front of the best conference audience around.
          <strong class="font-semibold">Submit by Jan 10, 2027.</strong>
        </p>
        <a href="https://cfp.cascadiajs.com" class={arrowLink}>
          Apply to speak <Arrow />
        </a>
      </div>
    </section>

    <HomeGallery />

    <section
      id="sponsor"
      class={`${container} pt-[65px] md:grid md:grid-cols-[367fr_209fr_593fr_7fr]`}
    >
      <div>
        <h2 class={heading}>Sponsor</h2>
        <p class={body}>
          CascadiaJS connects sponsors with highly technical developers who
          evaluate tools, share recommendations, and influence technology
          decisions at their organizations.
        </p>
        <a href="/sponsor" class={arrowLink}>See sponsor brochure <Arrow /></a>
      </div>
      <div class="mt-12 md:col-start-3 md:mt-0">
        <p class={`${eyebrow} mb-[30px] text-xl`}>Past sponsors</p>
        <ul
          class="m-0 grid list-none grid-cols-3 items-center gap-x-6 gap-y-10 p-0"
        >
          {
            pastSponsors.map((sponsor, i) => (
              <li
                class={`flex h-7 min-w-0 items-center md:h-10 ${sponsorAlign[i % 3]}`}
              >
                <Image
                  src={sponsorImages[`./${sponsor.logo}`]()}
                  alt={`${sponsor.name} logo`}
                  height={80}
                  class="h-auto max-h-full w-auto max-w-full"
                />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="testimonials" class={`${container} pt-16 pb-16`}>
      <hr class="border-sound-navy/10 m-0 mb-16 border-t" />
      <h2 class={`${heading} md:mb-16`}>Testimonials</h2>
      {
        /* Each embed is a fixed 300px column, so four need 1264px; as in the
           mockup, the row runs 88px past the content's right edge, but only
           from 1352px up, where the window has room for it. Narrower, they
           wrap. */
      }
      <div class="min-[1352px]:-mr-22">
        <Testimonials testimonials={testimonials} />
      </div>
      {/* Not a link until there's a page to send people to. */}
      <p class={`${arrowLink} mt-6 mb-0`}>
        More love for CascadiaJS <Arrow />
      </p>
    </section>
  </div>

  <HomeFooter slot="footer" />
</Layout>
