---
import EventLayout from "@layouts/EventLayout.astro";
---

<EventLayout
  year="2027"
  title="CascadiaJS 2027 | June 7 - 8 | Seattle, WA"
  displayAlert={false}
>
  <div id="form">
    <h1>Provide Email to Unlock Blind Bird Tickets</h1>
    <p>Blind Bird tickets are almost sold out!</p>
    <script is:inline>
      // Kit stores `cksubscribed-<form uid>` once someone submits this form;
      // anyone who already has skips straight to the ticket page.
      try {
        if (localStorage.getItem("cksubscribed-44b5c8e9d5")) {
          location.replace("/buy-tickets");
        }
      } catch {
        // Storage blocked: just show the form.
      }
    </script>
    <script
      async
      data-uid="44b5c8e9d5"
      src="https://cascadiajs.kit.com/44b5c8e9d5/index.js"></script>
    <!--p><strong>Bring a friend!</strong> Add 2 or more tickets to your cart for $50 off each ticket.</p-->
    <!--div>or just <a href="">click here</a> to proceed</div-->
  </div>
  <style>
    #form {
      padding: 32px;
    }
    @media only screen and (min-width: 768px) {
      #form {
        width: 50%;
        margin: 0 auto;
      }
    }
  </style>
</EventLayout>
