---
import EmailGateLayout from "@layouts/EmailGateLayout.astro";

// The 2027 ticket gate: people leave their email to see the ticket prices.
// Kit's "unlock tickets" form; once someone submits it, Kit sends them on
// to /buy-tickets.
const TICKETS_FORM_UID = "44b5c8e9d5";
---

<EmailGateLayout
  heading="View Ticket Prices"
  title="Tickets"
  uid={TICKETS_FORM_UID}
  next="/buy-tickets"
/>
