---
import { getCollection, render } from "astro:content";
import { findEventWithPages, sponsorPagePath } from "@shared/data/events";
import EventLayout from "@layouts/EventLayout.astro";
import SimplePage from "@layouts/SimplePage.astro";
import MarkdownContent from "@components/MarkdownContent.astro";
import SponsorsGrid from "@components/SponsorsGrid.astro";
import CtaButton from "@components/CtaButton.astro";
import Testimonials from "@components/Testimonials.astro";
import { DEFAULT_DESCRIPTION, DEFAULT_TITLE } from "@shared/site-defaults";

/**
 * Year-scoped markdown pages (src/content/markdown/<year>/*.md) render through this page.
 * This is a special case vs the catch-all slug page, which renders markdown pages
 * that are not year-scoped (src/content/markdown/*.md).
 */

export async function getStaticPaths() {
  const entries = await getCollection("markdown");
  return entries
    .filter((entry) => entry.data.published)
    .map((entry) => {
      const [, key, slug] = entry.id.match(/^(\d{4})\/(.+)$/) ?? [];
      const year = key ? findEventWithPages(key)?.year : undefined;
      return year ? { entry, year, slug } : null;
    })
    .filter((candidate) => candidate !== null)
    .map(({ entry, year, slug }) => ({
      params: { year, slug },
      props: { entry, year },
    }));
}

const { entry, year } = Astro.props;
const { slug } = Astro.params;
const { Content } = await render(entry);

// Legacy omits the year from the title template, and its brochure-request
// page (`/<year>/sponsor`) has no sharing handler, so it uses the sitewide
// defaults instead.
const isSponsorBrochure = slug === "sponsor";
const metaTitle = isSponsorBrochure
  ? DEFAULT_TITLE
  : `CascadiaJS | ${entry.data.title}`;
const metaDescription = isSponsorBrochure
  ? DEFAULT_DESCRIPTION
  : entry.data.description;
---

<EventLayout
  year={year}
  title={metaTitle}
  description={metaDescription}
  ogImage={entry.data.ogImage}
  displayAlert={entry.data.displayAlert}
>
  <SimplePage title={entry.data.title} width={entry.data.width}>
    <MarkdownContent>
      <Content />
    </MarkdownContent>
    <Fragment slot="after-body">
      {
        entry.data.showSponsors && (
          <section id="sponsors" class="box-content p-8 text-center">
            <h1 class="mt-0 mb-8 text-5xl">Our Sponsors</h1>
            <SponsorsGrid year={year} tiered={true} />
            <CtaButton href={sponsorPagePath(year)}>
              Sponsor Our Event
            </CtaButton>
          </section>
        )
      }
      {entry.data.showTestimonials && <Testimonials />}
    </Fragment>
  </SimplePage>
</EventLayout>
