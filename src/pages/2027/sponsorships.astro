---
import Layout from "@layouts/Layout.astro";
import CtaButton from "@components/CtaButton.astro";
import SponsorsGrid from "@components/SponsorsGrid.astro";
import Table from "@components/table/Table.astro";
import TableHead from "@components/table/TableHead.astro";
import TableBody from "@components/table/TableBody.astro";
import TableHeadRow from "@components/table/TableHeadRow.astro";
import TableRow from "@components/table/TableRow.astro";
import TableHeaderCell from "@components/table/TableHeaderCell.astro";
import TableLabelHeaderCell from "@components/table/TableLabelHeaderCell.astro";
import TableLabelCell from "@components/table/TableLabelCell.astro";
import TableCell from "@components/table/TableCell.astro";
import Testimonials from "@components/Testimonials.astro";
import { Image } from "astro:assets";
import logoImage from "@assets/events/2026/images/icon-dark-blue.png";
import heroImage from "@assets/events/2026/images/sponsor-brochure/hero.jpg";

// The sponsorship brochure is a standalone page meant to be shared with
// prospective sponsors: it draws its own header band (dates, URL, location)
// and logo below. So it uses the base Layout with the site nav and alert
// hidden, not EventLayout, whose Event nav would duplicate that header.
---

<Layout displayNav={false} displayAlert={false}>
  <nav
    class="bg-emerald-city-green text-sound-navy font-display flex p-3 text-center text-lg font-extralight"
  >
    <div class="w-1/3">June 7-8, 2027</div>
    <div class="w-1/3">cascadiajs.com/2027</div>
    <div class="w-1/3">Seattle, WA, USA</div>
  </nav>

  <section class="bg-mint py-4">
    <div class="text-center">
      <Image
        src={logoImage}
        alt="CascadiaJS logo"
        class="mx-auto h-25 w-auto"
      />
    </div>
    <h1 class="text-40 text-center">CascadiaJS 2027 Sponsorship Brochure</h1>
    <h2 class="text-32 mt-2 text-center">
      The Pacific Northwest&rsquo;s Web + AI Developer Conference
    </h2>
    <article class="mx-auto w-[90%] py-2 leading-[1.4em] md:w-1/2 md:py-6">
      Since 2012, we've been bringing together hundreds of developers to help
      them level up their skills, grow their network and have fun. We're excited
      to present our 14th annual conference, which will be held June 7-8, 2027
      at the Seattle Convention Center, located in the heart of downtown
      Seattle, WA.
    </article>
    <article
      class="p-2 text-center leading-[1.4em] md:mx-auto md:px-32 md:py-6"
    >
      <div class="flex flex-wrap justify-center gap-4">
        <CtaButton href="https://calendly.com/elise-worthy"
          >Book a time to talk</CtaButton
        >
        <CtaButton href="#event-at-a-glance" variant="secondary"
          >Learn more 👇</CtaButton
        >
      </div>
    </article>
    <article
      class="p-2 text-center leading-[1.4em] md:mx-auto md:px-32 md:py-6"
    >
      <Image
        src={heroImage}
        alt="CascadiaJS 2026 sponsorship brochure"
        class="mx-auto"
      />
    </article>

    <article
      class="mx-auto w-[90%] py-2 leading-[1.4em] md:w-1/2 md:py-6"
      id="event-at-a-glance"
    >
      <h2 class="text-32 mt-2 text-center">What It Is</h2>
      <p>
        <strong class="font-bold">CascadiaJS 2027</strong> is a two-day, <em
          >highly technical conference</em
        >.
      </p>

      <p>
        There will be at least <strong class="font-bold">20 expert talks</strong
        > covering web, JavaScript, and AI topics, plus structured, low-pressure networking
        opportunities that help companies build relationships with engineers in a
        technically focused, community-centric setting.
      </p>

      <p>
        <strong class="font-bold">Past sponsors</strong> include top web and developer
        brands such as Google, AWS, IBM, Elastic, Cloudflare, and many more &mdash;
        a testament to the value of connecting with this audience.
      </p>
    </article>

    <article class="mx-auto w-[90%] py-2 leading-[1.4em] md:w-1/2 md:py-6">
      <h2 class="text-32 mt-2 text-center">
        Connect with the Developers Building the Future of Web and AI
      </h2>
      <p>
        Since 2012, CascadiaJS has brought together developers building the
        modern web. Rooted in the JavaScript ecosystem and evolving alongside
        AI, CascadiaJS connects the engineers, tools, and ideas shaping the next
        generation of software.
      </p>

      <p>
        CascadiaJS connects sponsors with highly technical developers who
        evaluate tools, share recommendations, and influence technology
        decisions at their organizations.
      </p>

      <p>
        Unlike massive conferences where hundreds of exhibitors compete for
        passing traffic, CascadiaJS offers a high-trust environment for
        meaningful conversations. Demonstrate your technology, gather feedback,
        share expertise, build relationships, and get your products considered
        when teams make technology decisions.
      </p>

      <p>
        <strong class="font-bold"
          >More face time. Better conversations. High value from every
          sponsorship dollar.</strong
        >
      </p>
    </article>

    <article class="mx-auto w-[90%] py-2 leading-[1.4em] md:w-1/2 md:py-6">
      <h2 class="text-32 mt-2 text-center">Our Audience</h2>
      <p>
        CascadiaJS attracts an engaged community of developers working across
        JavaScript, modern web technologies, and AI.
      </p>
      <ul class="list-disc pl-6">
        <li><strong class="font-bold">600+ attendees</strong></li>
        <li>Frontend, full-stack, and platform engineers</li>
        <li>
          Strong representation of senior engineers and technical
          decision-influencers
        </li>
        <li>Primarily Pacific Northwest audience</li>
        <li>Active and passive job seekers</li>
        <li>High interest in modern web &amp; AI tooling</li>
        <li>
          <strong class="font-bold">5,400+ newsletter subscribers</strong>
        </li>
      </ul>
    </article>

    <h2 class="text-32 mt-2 text-center">Sponsorship Packages</h2>
    <article class="mx-auto w-[90%] py-2 leading-[1.4em] md:w-1/2 md:py-6">
      <p>
        Choose a base package, then add a talk or workshop and branded
        experiences to meet your goals.
      </p>
    </article>
  </section>

  <section class="bg-mint overflow-x-auto py-4">
    <Table>
      <TableHead>
        <TableHeadRow>
          <TableLabelHeaderCell>&nbsp;</TableLabelHeaderCell>
          <TableHeaderCell>Diamond</TableHeaderCell>
          <TableHeaderCell>Platinum</TableHeaderCell>
          <TableHeaderCell>Gold</TableHeaderCell>
          <TableHeaderCell>Silver</TableHeaderCell>
          <TableHeaderCell>Bronze</TableHeaderCell>
          <TableHeaderCell>Community</TableHeaderCell>
        </TableHeadRow>
      </TableHead>
      <TableBody>
        <TableRow>
          <TableLabelCell>
            <b>Quantity</b>
          </TableLabelCell>
          <TableCell>1</TableCell>
          <TableCell>1</TableCell>
          <TableCell>12</TableCell>
          <TableCell>Multiple</TableCell>
          <TableCell>Multiple</TableCell>
          <TableCell>Unlimited</TableCell>
        </TableRow>

        <TableRow>
          <TableLabelCell>
            <b>Dedicated Main-stage Banner</b>
          </TableLabelCell>
          <TableCell>
            <i class="fa-solid fa-check"></i>
          </TableCell>
          <TableCell colspan={5}>&nbsp;</TableCell>
        </TableRow>

        <TableRow>
          <TableLabelCell>
            <b>Main Stage 25-min Speaker Slot</b>
          </TableLabelCell>
          <TableCell>
            Keynote <i class="fa-solid fa-check"></i>
          </TableCell>
          <TableCell>
            <i class="fa-solid fa-check"></i>
          </TableCell>
          <TableCell colspan={4}>&nbsp;</TableCell>
        </TableRow>

        <TableRow>
          <TableLabelCell>
            <b>Live Stage Address</b>
          </TableLabelCell>
          <TableCell>5 minutes</TableCell>
          <TableCell>2 minutes</TableCell>
          <TableCell>2 minutes</TableCell>
          <TableCell colspan={3}>&nbsp;</TableCell>
        </TableRow>

        <TableRow>
          <TableLabelCell>
            <b>Custom Newsletter Message</b>
          </TableLabelCell>
          <TableCell>Full list</TableCell>
          <TableCell>Full list</TableCell>
          <TableCell>Attendees</TableCell>
          <TableCell colspan={3}>&nbsp;</TableCell>
        </TableRow>

        <TableRow>
          <TableLabelCell>
            <b>Booth</b>
          </TableLabelCell>
          <TableCell>Extra-large + monitor</TableCell>
          <TableCell>Extra-large + monitor</TableCell>
          <TableCell>6-foot + monitor</TableCell>
          <TableCell colspan={3}>&nbsp;</TableCell>
        </TableRow>

        <TableRow>
          <TableLabelCell>
            <b>Dedicated Sponsor Page</b>
          </TableLabelCell>
          <TableCell>
            <i class="fa-solid fa-check"></i>
          </TableCell>
          <TableCell>
            <i class="fa-solid fa-check"></i>
          </TableCell>
          <TableCell>
            <i class="fa-solid fa-check"></i>
          </TableCell>
          <TableCell colspan={3}>&nbsp;</TableCell>
        </TableRow>

        <TableRow>
          <TableLabelCell>
            <b>Lead Capture</b>
          </TableLabelCell>
          <TableCell>2 users</TableCell>
          <TableCell>2 users</TableCell>
          <TableCell>2 users</TableCell>
          <TableCell colspan={3}>&nbsp;</TableCell>
        </TableRow>

        <TableRow>
          <TableLabelCell>
            <b>Attendee-bag Item</b>
          </TableLabelCell>
          <TableCell>
            <i class="fa-solid fa-check"></i>
          </TableCell>
          <TableCell>
            <i class="fa-solid fa-check"></i>
          </TableCell>
          <TableCell>
            <i class="fa-solid fa-check"></i>
          </TableCell>
          <TableCell>
            <i class="fa-solid fa-check"></i>
          </TableCell>
          <TableCell colspan={2}>&nbsp;</TableCell>
        </TableRow>

        <TableRow>
          <TableLabelCell>
            <b>Dedicated Social Post</b>
          </TableLabelCell>
          <TableCell>
            <i class="fa-solid fa-check"></i>
          </TableCell>
          <TableCell>
            <i class="fa-solid fa-check"></i>
          </TableCell>
          <TableCell>
            <i class="fa-solid fa-check"></i>
          </TableCell>
          <TableCell colspan={3}>&nbsp;</TableCell>
        </TableRow>

        <TableRow>
          <TableLabelCell>
            <b>Grouped Social Post</b>
          </TableLabelCell>
          <TableCell colspan={3}>&nbsp;</TableCell>
          <TableCell>
            <i class="fa-solid fa-check"></i>
          </TableCell>
          <TableCell>
            <i class="fa-solid fa-check"></i>
          </TableCell>
          <TableCell>
            <i class="fa-solid fa-check"></i>
          </TableCell>
        </TableRow>

        <TableRow>
          <TableLabelCell>
            <b>Logo on Event Banners and Website</b>
          </TableLabelCell>
          <TableCell>
            <i class="fa-solid fa-check"></i>
          </TableCell>
          <TableCell>
            <i class="fa-solid fa-check"></i>
          </TableCell>
          <TableCell>
            <i class="fa-solid fa-check"></i>
          </TableCell>
          <TableCell>
            <i class="fa-solid fa-check"></i>
          </TableCell>
          <TableCell>
            <i class="fa-solid fa-check"></i>
          </TableCell>
          <TableCell>
            <i class="fa-solid fa-check"></i>
          </TableCell>
        </TableRow>

        <TableRow>
          <TableLabelCell>
            <b>Included Passes</b>
          </TableLabelCell>
          <TableCell>12</TableCell>
          <TableCell>10</TableCell>
          <TableCell>8</TableCell>
          <TableCell>4</TableCell>
          <TableCell>2</TableCell>
          <TableCell>1</TableCell>
        </TableRow>

        <TableRow>
          <TableLabelCell>
            <b>Discount on Additional Passes</b>
          </TableLabelCell>
          <TableCell>50%</TableCell>
          <TableCell>50%</TableCell>
          <TableCell>50%</TableCell>
          <TableCell>25%</TableCell>
          <TableCell>25%</TableCell>
          <TableCell>&nbsp;</TableCell>
        </TableRow>

        <TableRow>
          <TableLabelCell>
            <b>Price</b>
          </TableLabelCell>
          <TableCell>$43,000</TableCell>
          <TableCell>$32,000</TableCell>
          <TableCell>$21,500</TableCell>
          <TableCell>$8,600</TableCell>
          <TableCell>$5,400</TableCell>
          <TableCell>$2,700</TableCell>
        </TableRow>
      </TableBody>
    </Table>
  </section>

  <section id="speaking-workshop-addons" class="bg-mint py-4">
    <div class="mx-auto w-[90%] leading-[1.4em]">
      <h2 class="text-32 mt-2 text-center">Speaking &amp; Workshop Add-Ons</h2>
      <p class="mx-auto md:w-5/9">
        Share your expertise, showcase your technology, and give developers a
        deeper look at what your team is building.
      </p>
      <div class="my-7 overflow-x-auto">
        <Table class="[&_td]:text-left [&_th]:text-left">
          <colgroup>
            <col class="w-[36%]" />
            <col class="w-[16%]" />
            <col class="w-[16%]" />
            <col class="w-[16%]" />
            <col class="w-[16%]" />
          </colgroup>
          <TableHead>
            <TableHeadRow>
              <TableHeaderCell>Opportunity</TableHeaderCell>
              <TableHeaderCell>Price</TableHeaderCell>
              <TableHeaderCell>Diamond</TableHeaderCell>
              <TableHeaderCell>Platinum</TableHeaderCell>
              <TableHeaderCell>Gold</TableHeaderCell>
            </TableHeadRow>
          </TableHead>
          <TableBody>
            <TableRow>
              <TableLabelCell>
                <b>Workshop hosting</b>
              </TableLabelCell>
              <TableCell>$7,500</TableCell>
              <TableCell>Yes</TableCell>
              <TableCell>Yes</TableCell>
              <TableCell>Yes</TableCell>
            </TableRow>
            <TableRow>
              <TableLabelCell>
                <b>Main Stage Lightning Talk (10 min)</b>
              </TableLabelCell>
              <TableCell>$3,000</TableCell>
              <TableCell>Yes</TableCell>
              <TableCell>Yes</TableCell>
              <TableCell>Yes</TableCell>
            </TableRow>
          </TableBody>
        </Table>
      </div>
      <div class="mx-auto md:w-5/9">
        <h3 class="text-2xl"><strong>Workshop &mdash; $7,500</strong></h3>
        <p>
          Lead a hands-on session where developers build, experiment, or solve a
          technical problem with your team.
        </p>
        <h3 class="text-2xl"><strong>Lightning Talk &mdash; $3,000</strong></h3>
        <p>
          Share a focused technical idea, demo, or lesson in a short
          presentation.
        </p>
        <p>
          <em
            >Speaking and workshop opportunities are limited, subject to
            approval, and purchased in addition to the base sponsorship package.</em
          >
        </p>
      </div>
    </div>
  </section>

  <section class="bg-mint py-4">
    <div class="mx-auto w-[90%] leading-[1.4em]">
      <h2 class="text-32 mt-2 text-center">
        Additional Sponsorship Opportunities
      </h2>
      <p class="mx-auto md:w-5/9">
        Put your brand into the moments where developers gather, connect, and
        learn. These opportunities offer additional visibility and ways to
        engage with the CascadiaJS community.
      </p>
      <div
        class="my-7 overflow-x-auto"
        role="region"
        aria-label="Sponsorship add-on opportunities"
        tabindex="0"
      >
        <Table class="[&_td]:text-left [&_th]:text-left">
          <colgroup>
            <col class="w-1/4" />
            <col class="w-[15%]" />
            <col class="w-[60%]" />
          </colgroup>
          <TableHead>
            <TableHeadRow>
              <TableHeaderCell>Opportunity</TableHeaderCell>
              <TableHeaderCell>Price</TableHeaderCell>
              <TableHeaderCell>What's included</TableHeaderCell>
            </TableHeadRow>
          </TableHead>
          <TableBody>
            <TableRow>
              <TableLabelCell><b>Karaoke After-party</b></TableLabelCell>
              <TableCell>$10,000</TableCell>
              <TableCell
                >Premier sponsorship with prominent branding at the conference
                after-party on June 8.</TableCell
              >
            </TableRow>
            <TableRow>
              <TableLabelCell><b>Welcome Reception</b></TableLabelCell>
              <TableCell>$7,500</TableCell>
              <TableCell
                >Branding at the opening social event on June 6.</TableCell
              >
            </TableRow>
            <TableRow>
              <TableLabelCell><b>Networking Mixer</b></TableLabelCell>
              <TableCell>$5,000</TableCell>
              <TableCell
                >Branding at a dedicated networking experience on June 7.</TableCell
              >
            </TableRow>
            <TableRow>
              <TableLabelCell><b>Lanyards</b></TableLabelCell>
              <TableCell>$5,000</TableCell>
              <TableCell>Logo on attendee lanyards.</TableCell>
            </TableRow>
            <TableRow>
              <TableLabelCell><b>Coffee</b></TableLabelCell>
              <TableCell>$4,000</TableCell>
              <TableCell>Branding at conference coffee stations.</TableCell>
            </TableRow>
            <TableRow>
              <TableLabelCell><b>Conference Videos</b></TableLabelCell>
              <TableCell>$4,000</TableCell>
              <TableCell
                >Brand placement associated with conference recordings.</TableCell
              >
            </TableRow>
            <TableRow>
              <TableLabelCell><b>Tote Bags</b></TableLabelCell>
              <TableCell>$4,000</TableCell>
              <TableCell>Logo on attendee tote bags.</TableCell>
            </TableRow>
            <TableRow>
              <TableLabelCell><b>ASL Interpretation</b></TableLabelCell>
              <TableCell>$4,000</TableCell>
              <TableCell
                >Recognition as a supporter of conference accessibility.</TableCell
              >
            </TableRow>
            <TableRow>
              <TableLabelCell><b>Photo Booth</b></TableLabelCell>
              <TableCell>$2,500</TableCell>
              <TableCell>Branded photo experience for attendees.</TableCell>
            </TableRow>
            <TableRow>
              <TableLabelCell><b>Scholarships</b></TableLabelCell>
              <TableCell>$2,500</TableCell>
              <TableCell
                >Recognition as a supporter of attendee scholarships.</TableCell
              >
            </TableRow>
          </TableBody>
        </Table>
      </div>

      <div class="mx-auto md:w-5/9">
        <h2 id="book-call" class="text-32 mt-2 text-center">
          Build Your Package
        </h2>
        <p>
          Start with a sponsorship package that fits your goals, then add
          speaking opportunities, hands-on workshops, or branded experiences to
          expand your reach. Whether you're showcasing a product, sharing
          technical expertise, or building relationships with developers,
          CascadiaJS offers more opportunities for meaningful engagement and
          more value from your sponsorship investment.
        </p>
        <p>
          <strong class="font-bold">Contact:</strong> elise@cascadiajs.com
        </p>
        <CtaButton href="https://calendly.com/elise-worthy" variant="secondary"
          >Book a time to talk</CtaButton
        >
      </div>
    </div>
  </section>

  <Testimonials />

  <SponsorsGrid exclude="2026" />
</Layout>
