---
import EventLayout from "@layouts/EventLayout.astro";
import { FEATURED_EVENT } from "@shared/site-defaults";
---

<!-- The Featured Event's nav, as on `/` and `/tos`. -->
<EventLayout
  year={FEATURED_EVENT}
  title="404"
  description="404"
  displayAlert={false}
>
  <main>
    <h1 class="sr-only">404</h1>
    <p class="sr-only">Page not found</p>
    <div class="flex items-center justify-center">
      <video autoplay muted loop width="100%">
        <source
          type="video/mp4"
          src="https://media.giphy.com/media/jkZtSdwKOx05BOlapR/source.mp4?cid=ecf05e474kgt0ax6stge6re5otcyqmhf7p7bx1ncirx3lp2q&rid=source.mp4&ct=g"
        />
      </video>
    </div>
  </main>
</EventLayout>
