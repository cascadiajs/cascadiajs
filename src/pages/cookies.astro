---
import InteriorLayout from "@layouts/InteriorLayout.astro";
import TermlyEmbed from "@components/TermlyEmbed.astro";
---

{
  /* Termly shows the policy, with its own title, in an iframe we can't
     style, so the page's h1 is for screen readers only. */
}
<InteriorLayout title="Cookie Policy" hideTitle>
  <TermlyEmbed policyId="c908c74a-9cf7-44ac-a425-1891ab411ee8" />
</InteriorLayout>
