---
import EventLayout from "@layouts/EventLayout.astro";
import TermlyEmbed from "@components/TermlyEmbed.astro";
import SponsorsGrid from "@components/SponsorsGrid.astro";
import CtaButton from "@components/CtaButton.astro";
import Testimonials from "@components/Testimonials.astro";
import {
  DEFAULT_DESCRIPTION,
  DEFAULT_TITLE,
  FEATURED_EVENT,
} from "@shared/site-defaults";
---

<!-- The Featured Event's nav, as on `/`, with the sitewide head defaults. -->
<EventLayout
  year={FEATURED_EVENT}
  title={DEFAULT_TITLE}
  description={DEFAULT_DESCRIPTION}
  displayAlert={false}
>
  <TermlyEmbed policyId="b7514956-3e05-45e8-a6fc-5714b3e584d4" />

  <section id="sponsors" class="box-content p-8 text-center">
    <h2 class="font-display mt-0 mb-8 text-5xl">Past Sponsors</h2>
    <SponsorsGrid exclude={FEATURED_EVENT} />
    <CtaButton href="/sponsor">Sponsor Our Event</CtaButton>
  </section>

  <Testimonials />
</EventLayout>
