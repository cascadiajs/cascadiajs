---
import { FEATURED_EVENT, PRICE_INCREASE_AT } from "@shared/site-defaults";

interface Props {
  displayNav?: boolean;
  displayAlert?: boolean;
}

const { displayNav = true, displayAlert = true } = Astro.props;
---

<header class="cjs-site-header font-extralight">
  {
    /* Alert banner: a countdown to the next ticket price increase. It's
       hidden in the HTML; the script right after it fills in the days left
       from the visitor's clock and shows it, before the page first paints,
       so the page doesn't jump down when it appears. Once prices have gone
       up it stays hidden. */
    displayAlert && (
      <div
        class="cjs-alert-banner bg-madrona-yellow text-sound-navy px-4 py-2 text-center font-sans text-lg leading-snug font-medium"
        data-price-alert
        hidden
      >
        Last chance for Blind Bird tickets! Prices go up{" "}
        <span data-price-alert-when>soon</span>.{" "}
        <a
          href="/tickets"
          class="bg-sound-navy ml-1 inline-block rounded-[5px] px-3 py-0.5 font-sans text-base font-bold whitespace-nowrap text-white no-underline hover:bg-[color-mix(in_srgb,var(--color-sound-navy),black_30%)]"
        >
          Save $100
        </a>
      </div>
    )
  }
  {/* Does nothing on a page without the banner. */}
  <script is:inline define:vars={{ priceIncreaseAt: PRICE_INCREASE_AT }}>
    (() => {
      const banner = document.querySelector("[data-price-alert]");
      const days = Math.ceil(
        (Date.parse(priceIncreaseAt) - Date.now()) / 86400000,
      );
      if (!banner || !(days > 0)) {
        return;
      }
      banner.querySelector("[data-price-alert-when]").textContent =
        days === 1 ? "tonight" : `in ${days} days`;
      banner.hidden = false;
    })();
  </script>

  <!-- Primary nav -->
  {
    displayNav && (
      <nav class="bg-emerald-city-green px-3 py-3 text-center">
        <div class="md:mx-auto md:flex md:w-[70%] md:items-center">
          {/* Logo */}
          <a href="/" id="logo" class="m-1 pr-1.25">
            <img
              src="/images/cjs-lockup-blue.svg"
              alt="CascadiaJS logo"
              class="inline h-7 w-auto align-baseline"
            />
          </a>

          {/* Nav links: pushed to the right on desktop, stacked on mobile */}
          <div class="md:ml-auto md:flex md:items-center">
            <a
              href="/"
              class="font-display text-sound-navy text-21 mt-1 block px-1 font-medium no-underline hover:underline md:mt-0 md:inline-block"
            >
              CascadiaJS {FEATURED_EVENT}
            </a>
            <a
              href="/blog"
              class="font-display text-sound-navy text-21 mt-1 block px-1 font-medium no-underline hover:underline md:mt-0 md:ml-4 md:inline-block"
            >
              Blog
            </a>
            <a
              href="/mailing-list"
              class="font-display text-sound-navy text-21 mt-1 block px-1 font-medium no-underline hover:underline md:mt-0 md:ml-4 md:inline-block"
            >
              Newsletter
            </a>
            <a
              href="/code-of-conduct"
              class="font-display text-sound-navy text-21 mt-1 block px-1 font-medium no-underline hover:underline md:mt-0 md:ml-4 md:inline-block"
            >
              Code of Conduct
            </a>
          </div>
        </div>
      </nav>
    )
  }
</header>
