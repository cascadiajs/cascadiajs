---
import { FEATURED_EVENT } from "@shared/site-defaults";

interface Props {
  displayNav?: boolean;
  displayAlert?: boolean;
}

const { displayNav = true, displayAlert = true } = Astro.props;
---

<header class="cjs-site-header font-extralight">
  <!-- Alert banner -->
  {
    displayAlert && (
      <div class="cjs-alert-banner bg-madrona-yellow text-sound-navy font-display p-2 text-center text-xl">
        <a href="/2027">
          Blind Bird tickets are on sale now for CascadiaJS 2027!
        </a>
      </div>
    )
  }

  <!-- Primary nav -->
  {
    displayNav && (
      <nav class="bg-emerald-city-green px-3 py-3 text-center">
        <div class="md:mx-auto md:flex md:w-[70%] md:items-center">
          {/* Logo */}
          <a href="/" id="logo" class="m-1 pr-1.25">
            <img
              src="/images/cjs-lockup-blue.svg"
              alt="CascadiaJS logo"
              class="inline h-7 w-auto align-baseline"
            />
          </a>

          {/* Nav links: pushed to the right on desktop, stacked on mobile */}
          <div class="md:ml-auto md:flex md:items-center">
            <a
              href={`/${FEATURED_EVENT}`}
              class="font-display text-sound-navy text-21 mt-1 block px-1 font-medium no-underline hover:underline md:mt-0 md:inline-block"
            >
              CascadiaJS {FEATURED_EVENT}
            </a>
            <a
              href="/mailing-list"
              class="font-display text-sound-navy text-21 mt-1 block px-1 font-medium no-underline hover:underline md:mt-0 md:ml-4 md:inline-block"
            >
              Newsletter
            </a>
            <a
              href="/code-of-conduct"
              class="font-display text-sound-navy text-21 mt-1 block px-1 font-medium no-underline hover:underline md:mt-0 md:ml-4 md:inline-block"
            >
              Code of Conduct
            </a>
          </div>
        </div>
      </nav>
    )
  }
</header>
