---
/**
 * Reading progress bar for a Post. CSS only: the fill is driven by the page's
 * scroll timeline. It sits under the site header, scrolls with the page, then
 * pins to the top. Place it as the first child of a tall element.
 * Browsers without scroll timelines show no bar. No bar under reduced motion.
 */
---

<div class="cjs-progress-bar" aria-hidden="true">
  <div class="cjs-progress-bar-fill"></div>
</div>

<style>
  .cjs-progress-bar {
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    .cjs-progress-bar {
      display: block;
      position: sticky;
      top: 0;
      z-index: 40;
      height: 0.5rem;
      background-color: color-mix(in srgb, var(--color-sound-navy) 10%, white);
    }

    .cjs-progress-bar-fill {
      height: 100%;
      background-color: var(--color-madrona-yellow);
      transform: scaleX(0);
      transform-origin: left;
      animation-name: cjs-progress-grow;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root block);
    }

    @media (prefers-reduced-motion: reduce) {
      .cjs-progress-bar {
        display: none;
      }
    }
  }

  @keyframes cjs-progress-grow {
    to {
      transform: scaleX(1);
    }
  }
</style>
