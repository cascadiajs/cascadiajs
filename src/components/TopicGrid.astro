---
interface Props {
  groups: {
    title: string;
    topics: string[];
  }[];
}

const { groups } = Astro.props;
---

<div class="topic-grid @container my-6">
  <div class="grid grid-cols-1 gap-x-6 gap-y-6 @min-xl:grid-cols-2">
    {
      groups.map((group, index) => (
        <section
          class:list={[
            "min-w-0",
            groups.length % 2 === 1 &&
              index === groups.length - 1 &&
              "@min-xl:col-span-2",
          ]}
        >
          <h3 class="mt-0! mb-3! text-lg!">{group.title}</h3>
          <ul
            role="list"
            class="m-0! flex list-none! flex-col items-start gap-2 p-0!"
          >
            {group.topics.map((topic) => (
              <li class="max-w-full p-0! leading-snug!">
                <span class="border-emerald-city-green/30 bg-mint/60 text-sound-navy inline-block rounded-2xl border px-3 py-1.5 text-base leading-snug font-medium">
                  {topic}
                </span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</div>
