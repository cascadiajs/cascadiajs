---
import type { ImageMetadata } from "astro";
interface Props {
  preHeader: string;
  heading: string;
  imageSrc: ImageMetadata;
  imageAlt: string;
}
import { Image } from "astro:assets";

const { preHeader, heading, imageSrc, imageAlt } = Astro.props;
---

<section class="hero p-8 text-left md:mx-auto md:flex md:max-w-266">
  <article class="md:mr-4 md:flex-1">
    <div class="font-display text-sound-navy m-0 text-lg">{preHeader}</div>
    <h2 class="text-32 mt-4 mb-0">{heading}</h2>
    <br />
    <slot />
  </article>
  <article class="md:flex-1">
    <Image
      src={imageSrc}
      alt={imageAlt}
      class="h-auto w-full"
      fetchpriority="high"
      loading="eager"
      layout="full-width"
    />
  </article>
</section>
