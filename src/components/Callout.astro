---
/**
 * Block-level callout, styled after the legacy `div.highlight` classes
 * (Legacy Site, `cascadiajs-legacy-pre-migration` branch,
 * `public/styles/main.css`, "start highlight" block).
 * The legacy version used a Font Awesome `::before` icon on the `info`
 * variant only; here every variant gets a default inline SVG icon
 * (overridable via the `icon` slot) laid out with flexbox instead of a
 * pseudo-element, per ADR-0012's guidance that new MDX content composes
 * real components rather than class-name-driven markup.
 */
interface Props {
  variant: "info" | "success" | "warning" | "error";
}

const { variant } = Astro.props;

const variantClasses: Record<Props["variant"], string> = {
  info: "bg-overcast-gray text-sound-navy",
  success: "bg-emerald-city-green text-sound-navy",
  warning: "bg-[#ffcf07] text-sound-navy",
  error: "bg-[#ee3e4a] text-white",
};
---

<div
  class={`cjs-callout rounded font-medium p-4 my-2 text-center flex items-center justify-center ${variantClasses[variant]}`}
>
  <div class="flex items-start gap-2">
    <span
      class="mt-0.5 inline-flex h-6 shrink-0 items-center"
      aria-hidden="true"
    >
      <slot name="icon" class="pt-1">
        {
          variant === "info" && (
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="size-5"
            >
              <path d="M12 .75a8.25 8.25 0 0 0-4.135 15.39c.686.398 1.115 1.008 1.134 1.623a.75.75 0 0 0 .577.706c.352.083.71.148 1.074.195.323.041.6-.218.6-.544v-.415a3 3 0 0 1 1.5 0v.415c0 .326.277.585.6.544.364-.047.722-.112 1.074-.195a.75.75 0 0 0 .577-.706c.02-.615.448-1.225 1.134-1.623A8.25 8.25 0 0 0 12 .75Z" />
              <path
                fill-rule="evenodd"
                d="M9.013 19.9a.75.75 0 0 1 .877-.597 11.32 11.32 0 0 0 4.22 0 .75.75 0 1 1 .28 1.473 12.82 12.82 0 0 1-4.78 0 .75.75 0 0 1-.597-.876ZM9.754 22.344a.75.75 0 0 1 .824-.668 13.68 13.68 0 0 0 2.844 0 .75.75 0 1 1 .156 1.492 15.16 15.16 0 0 1-3.156 0 .75.75 0 0 1-.668-.824Z"
                clip-rule="evenodd"
              />
            </svg>
          )
        }
        {
          variant === "success" && (
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              class="size-5"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z"
                clip-rule="evenodd"
              />
            </svg>
          )
        }
        {
          variant === "warning" && (
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="size-5"
            >
              <path
                fill-rule="evenodd"
                d="M9.401 3.003c1.155-2 4.043-2 5.197 0l7.355 12.748c1.154 2-.29 4.5-2.599 4.5H4.645c-2.309 0-3.752-2.5-2.598-4.5L9.4 3.003ZM12 8.25a.75.75 0 0 1 .75.75v3.75a.75.75 0 0 1-1.5 0V9a.75.75 0 0 1 .75-.75Zm0 8.25a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Z"
                clip-rule="evenodd"
              />
            </svg>
          )
        }
        {
          variant === "error" && (
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              class="size-5"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM8.28 7.22a.75.75 0 0 0-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 1 0 1.06 1.06L10 11.06l1.72 1.72a.75.75 0 1 0 1.06-1.06L11.06 10l1.72-1.72a.75.75 0 0 0-1.06-1.06L10 8.94 8.28 7.22Z"
                clip-rule="evenodd"
              />
            </svg>
          )
        }
      </slot>
    </span>
    <span class="[&_p]:m-0"><slot /></span>
  </div>
</div>
