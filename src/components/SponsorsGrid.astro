---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import type { EventYear, Sponsor } from "@shared/data/types";

interface BaseProps {
  /**
   * Event Key(s) to exclude. A Sponsor is hidden only when *every* one of its
   * Events is excluded, so a Sponsor in both 2025 and 2026 still shows under
   * exclude="2026". This is what reproduces the legacy "Past Sponsors" set;
   * dropping every Sponsor that merely touches 2026 would lose returning
   * Sponsors such as Cloudflare, Arcjet and Elastic.
   */
  exclude?: Sponsor["events"][number] | Sponsor["events"][number][];
}

/**
 * `year` is the Event Key to include (e.g. "2026"); omit to consider every
 * Sponsor. It excludes `previous` (no `/previous/sponsors/<id>` pages exist)
 * and is required when `tiered`, since tiered logos link to
 * `/<year>/sponsors/<id>`.
 */
type Props =
  | (BaseProps & { tiered: true; year: EventYear })
  | (BaseProps & { tiered?: false; year?: EventYear });

const { year, exclude, tiered = false } = Astro.props;

const sponsorsData = await getCollection("sponsors");
const sponsors = sponsorsData.map((s) => s.data);

const excluded =
  exclude === undefined ? [] : Array.isArray(exclude) ? exclude : [exclude];

const selected = sponsors.filter((sponsor) => {
  if (year && !sponsor.events.includes(year)) {
    return false;
  }
  if (
    excluded.length > 0 &&
    sponsor.events.every((e) => excluded.includes(e))
  ) {
    return false;
  }
  return true;
});

// Fixed tier order (diamond -> media); only the top four tiers link out.
const TIER_ORDER = [
  "diamond",
  "platinum",
  "gold",
  "silver",
  "bronze",
  "community",
  "media",
] as const;
const LINKED_TIERS = new Set(["diamond", "platinum", "gold", "silver"]);

// md-breakpoint logo heights, one per tier, in TIER_ORDER order.
const TIER_HEIGHT: Record<(typeof TIER_ORDER)[number], string> = {
  diamond: "md:h-[200px]",
  platinum: "md:h-[142px]",
  gold: "md:h-[110px]",
  silver: "md:h-[84px]",
  bronze: "md:h-[65px]",
  community: "md:h-[50px]",
  media: "md:h-[50px]",
};

const flatSponsors = tiered
  ? []
  : [...selected].sort((a, b) => a.name.localeCompare(b.name));

const tierBands = tiered
  ? TIER_ORDER.map((tier) => ({
      tier,
      sponsors: selected.filter((sponsor) => sponsor.tier === tier),
    })).filter((band) => band.sponsors.length > 0)
  : [];

const sponsorImages = import.meta.glob<{ default: ImageMetadata }>(
  "@assets/images/sponsors/*.{jpg,png,svg,jpeg}",
  { eager: false, base: "/src/assets/images/sponsors" },
);
---

{
  tiered ? (
    <div class="cjs-sponsors-grid">
      {tierBands.map(({ tier, sponsors: tierSponsors }) => (
        <>
          <div class="relative my-5 text-center">
            <div class="border-sound-navy/20 absolute top-1/2 left-0 w-full border-t" />
            <div class="relative inline-flex justify-center px-2.5">
              <span class="text-sound-navy inline-block h-5 bg-[#d1f3e5] p-2">
                {tier}
              </span>
            </div>
          </div>
          <div class="md:flex md:flex-wrap md:justify-center">
            {tierSponsors.map((sponsor) => {
              const logo = (
                <Image
                  src={sponsorImages[`./${sponsor.logo}`]()}
                  alt={`${sponsor.name} logo`}
                  layout="none"
                  class="mx-auto my-8 block h-12.5 w-auto md:m-0 md:inline md:h-full"
                />
              );
              return (
                <div
                  class={`cjs-sponsor-tier-${tier} text-center md:m-8 ${TIER_HEIGHT[tier]}`}
                >
                  {LINKED_TIERS.has(tier) ? (
                    sponsor.description ? (
                      <a href={`/${year}/sponsors/${sponsor.id}`}>{logo}</a>
                    ) : (
                      <a href={sponsor.url} target="_blank" rel="noopener">
                        {logo}
                      </a>
                    )
                  ) : (
                    logo
                  )}
                </div>
              );
            })}
          </div>
        </>
      ))}
    </div>
  ) : (
    <div class="cjs-sponsors-grid md:flex md:flex-wrap md:justify-center">
      {flatSponsors.map((sponsor) => (
        <div id={`sponsor-${sponsor.id}`} class="text-center md:m-8">
          <Image
            src={sponsorImages[`./${sponsor.logo}`]()}
            alt={`${sponsor.name} logo`}
            height={60}
            alt={`${sponsor.name} logo`}
            class="mx-auto my-8 block h-12.5 md:m-0 md:inline md:h-15"
          />
        </div>
      ))}
    </div>
  )
}
