---
import type { HTMLAttributes } from "astro/types";

type AnchorTarget = "_self" | "_blank" | "_parent" | "_top" | (string & {});

interface Props extends HTMLAttributes<"a"> {
  href: string;
  variant?: "primary" | "secondary";
  target?: AnchorTarget;
  /** Geometry: padding/margin/flow (div vs span). */
  display?: "inline" | "block";
  /**
   * Text size, independent of geometry. Defaults per display (24px block,
   * 18px inline). Pass "lg" with display="inline" on the schedule page --
   * its `.day .cta` rule beats `span.cta` by specificity, rendering
   * inline CTAs at 24px there too.
   */
  size?: "sm" | "lg";
}

const {
  href,
  variant = "primary",
  target,
  display = "block",
  size = display === "inline" ? "sm" : "lg",
  class: className,
  ...attrs
} = Astro.props;

// Geometry only -- no font-size here, that comes from `sizes` below.
const base = {
  block: "font-display my-4 inline-block border-4 px-4 py-2 font-medium",
  inline: "font-display border-4 p-2 font-medium",
};

const sizes = {
  sm: "text-lg",
  lg: "text-2xl leading-body",
};

const Tag = display === "inline" ? "span" : "div";

const variants = {
  primary:
    "bg-cascade-blue border-cascade-blue hover:bg-sound-navy hover:border-sound-navy",
  secondary:
    "border-cascade-blue hover:border-sound-navy bg-transparent font-light",
};

const linkVariants = {
  primary: "text-cedar-cream no-underline",
  secondary: "text-cascade-blue group-hover:text-sound-navy no-underline",
};
---

<Tag class={`group ${base[display]} ${sizes[size]} ${variants[variant]}`}>
  {
    /* No whitespace before <slot />: a literal newline renders as a real
       space, visibly padding the label width (caught by the fidelity
       compare, #35). */
  }
  <a
    {...attrs}
    href={href}
    target={target}
    class:list={[linkVariants[variant], className]}><slot /></a
  >
</Tag>
