---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getCollection } from "astro:content";

/**
 * The past Sponsors people in tech know best, as a 3-column logo grid with
 * a "Past sponsors" badge in the middle cell. Used by the home page's
 * sponsor section and /sponsorships. It sizes itself to its container.
 */
interface Props {
  class?: string;
}

const PAST_SPONSOR_IDS = [
  "atlassian",
  "auth0",
  "aws",
  "bluesky",
  "circleci",
  "cloudflare",
  "datadog",
  "elastic",
  "github",
  "google",
  "langchain",
  "netlify",
  "new-relic",
  "postman",
  "pulumi",
  "retool",
  "sentry",
  "tmobile",
  "twilio",
  "uber",
];
const pastSponsors = (await getCollection("sponsors"))
  .map((entry) => entry.data)
  .filter((sponsor) => PAST_SPONSOR_IDS.includes(sponsor.id))
  .sort((a, b) => a.name.localeCompare(b.name));
// Logos shown here in place of a Sponsor's own: GitHub as its lockup. The
// Sponsor record keeps the logo its event pages use.
const LOGOS: Record<string, { logo: string; name: string }> = {
  github: { logo: "github-lockup.svg", name: "GitHub" },
};
const sponsorImages = import.meta.glob<{ default: ImageMetadata }>(
  "@assets/images/sponsors/*.{jpg,png,svg,jpeg}",
  { eager: false, base: "/src/assets/images/sponsors" },
);
// The logos run left, centre, right across each row of three.
const align = ["justify-start", "justify-center", "justify-end"];
// The badge (null) goes in the middle cell. With 3 columns that cell is the
// exact center only for an even number of logos in an odd number of rows
// (20 logos make 3×7 with the badge).
const half = Math.floor(pastSponsors.length / 2);
const cells = [
  ...pastSponsors.slice(0, half),
  null,
  ...pastSponsors.slice(half),
];

const { class: className } = Astro.props;
---

<ul
  aria-label="Past sponsors"
  class:list={[
    "@container m-0 grid list-none grid-cols-3 items-center gap-x-6 gap-y-10 p-0",
    className,
  ]}
>
  {
    cells.map((sponsor, i) =>
      sponsor ? (
        <li class={`flex h-7 min-w-0 items-center md:h-10 ${align[i % 3]}`}>
          <Image
            src={sponsorImages[
              `./${LOGOS[sponsor.id]?.logo ?? sponsor.logo}`
            ]()}
            alt={`${LOGOS[sponsor.id]?.name ?? sponsor.name} logo`}
            height={80}
            class="h-auto max-h-full w-auto max-w-full"
          />
        </li>
      ) : (
        /* A badge like the Past speakers one on the home page's CFP grid, in
           navy to stand out on the mist background. The list's label says
           the same to screen readers. It's sized to the grid. */
        <li
          aria-hidden="true"
          class="flex h-7 items-center justify-center md:h-10"
        >
          <span class="font-display bg-sound-navy text-mist rounded-[0.4em] px-[0.8em] py-[0.5em] text-[clamp(13px,4.6cqw,25px)] leading-none font-light whitespace-nowrap">
            Past sponsors
          </span>
        </li>
      ),
    )
  }
</ul>
