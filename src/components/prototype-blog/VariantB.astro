---
/**
 * PROTOTYPE, throwaway (issue #55). Variant B, "Poster": loud brand blocks.
 * Navy bands with display type, three equal image-overlay Featured cards,
 * a 3-column card grid with numbered pagination, a big yellow search band,
 * the progress bar sticky directly under the site header (it scrolls with
 * the page until the header is gone, then pins to the top), a sticky
 * vertical share rail beside the Post, and a dark code theme.
 */
import { Image } from "astro:assets";
import PostBody from "./PostBody.astro";
import {
  featured,
  list,
  post,
  tag,
  tagged,
  author,
  byAuthor,
  query,
  results,
  allTags,
  fmtDate,
  shareLinks,
} from "./data";

const url = `https://cascadiajs.com/blog/post/${post.slug}`;
const shares = shareLinks(url, post.title);
const wrap = "mx-auto box-content max-w-[1200px] px-4";
const chip =
  "bg-mint text-sound-navy rounded-full px-3 py-0.5 text-sm font-medium no-underline hover:bg-emerald-city-green";
---

<div data-variant="B">
  {/* ───────────── INDEX ───────────── */}
  <section data-view="index">
    <div class="bg-sound-navy text-cedar-cream">
      <div class={`${wrap} py-12`}>
        <h1 class="font-display text-cedar-cream my-0 text-[96px] leading-none">
          The Blog
        </h1>
        <div class="mt-10 grid gap-4 md:grid-cols-3">
          {
            featured.map((p) => (
              <a
                href="#"
                class="group relative block aspect-[3/4] overflow-hidden rounded-lg no-underline"
              >
                {p.image && (
                  <Image
                    src={p.image}
                    alt=""
                    width={600}
                    class="absolute inset-0 size-full object-cover transition group-hover:scale-105"
                  />
                )}
                <div class="from-sound-navy via-sound-navy/60 absolute inset-0 bg-gradient-to-t to-transparent" />
                <div class="absolute inset-x-0 bottom-0 p-5">
                  <span class="bg-madrona-yellow text-sound-navy font-display rounded px-2 py-0.5 text-sm">
                    Featured
                  </span>
                  <h2 class="font-display text-cedar-cream text-32 mt-3 mb-2">
                    {p.title}
                  </h2>
                  <p class="text-cedar-cream/80 m-0 text-sm">
                    {p.author.name} · {p.minutes} min
                  </p>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div class="bg-overcast-gray">
      <form
        class={`${wrap} flex flex-wrap items-center gap-3 py-5`}
        action="#"
        onsubmit="return false"
      >
        <i class="fa-solid fa-magnifying-glass text-sound-navy text-2xl"></i>
        <input
          type="search"
          placeholder="Search by title, author or tag…"
          class="text-22 border-sound-navy placeholder:text-sound-navy/50 min-w-0 flex-1 border-b-2 bg-transparent px-2 py-2 focus:outline-none"
        />
        <select
          class="border-sound-navy rounded border-2 bg-transparent px-2 py-2"
        >
          <option>Any tag</option>
          {allTags.map((t) => <option>{t}</option>)}
        </select>
        <button
          class="bg-sound-navy text-cedar-cream font-display rounded px-5 py-2"
          >Go</button
        >
      </form>
    </div>

    <div class={`${wrap} py-12`}>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          list.map((p) => (
            <article class="ring-sound-navy/10 flex flex-col overflow-hidden rounded-lg bg-white shadow-sm ring-1">
              {p.image ? (
                <Image
                  src={p.image}
                  alt=""
                  width={600}
                  class="aspect-[16/10] w-full object-cover"
                />
              ) : (
                <div class="bg-cascade-blue font-display text-cedar-cream flex aspect-[16/10] items-center justify-center p-6 text-center text-2xl">
                  {p.title}
                </div>
              )}
              <div class="flex flex-1 flex-col p-5">
                <div class="flex flex-wrap gap-2">
                  {p.tags.map((t) => (
                    <a href="#" class={chip}>
                      {t}
                    </a>
                  ))}
                </div>
                <h3 class="font-display text-sound-navy mt-3 mb-2 text-2xl">
                  <a
                    href="#"
                    class="text-sound-navy no-underline hover:underline"
                  >
                    {p.title}
                  </a>
                </h3>
                <p class="flex-1 text-base">{p.description}</p>
                <div class="mt-2 flex items-center gap-2 text-sm">
                  <Image
                    src={p.author.image}
                    alt=""
                    width={64}
                    class="size-8 rounded-full object-cover"
                  />
                  <span class="font-medium">{p.author.name}</span>
                  <span class="text-sound-navy/70 ml-auto">
                    {p.minutes} min
                  </span>
                </div>
              </div>
            </article>
          ))
        }
      </div>
      <nav class="mt-12 flex justify-center gap-2">
        <span
          class="bg-sound-navy text-cedar-cream flex size-11 items-center justify-center rounded-full font-medium"
          >1</span
        >
        <a
          href="#"
          class="ring-sound-navy text-sound-navy flex size-11 items-center justify-center rounded-full font-medium no-underline ring-2"
          >2</a
        >
        <a
          href="#"
          class="ring-sound-navy text-sound-navy flex size-11 items-center justify-center rounded-full font-medium no-underline ring-2"
          >3</a
        >
        <a
          href="#"
          class="ring-sound-navy text-sound-navy flex h-11 items-center justify-center rounded-full px-4 font-medium no-underline ring-2"
          >Next →</a
        >
      </nav>
    </div>
  </section>

  {/* ───────────── SEARCH ───────────── */}
  <section data-view="search">
    <div class="bg-overcast-gray">
      <form
        class={`${wrap} flex flex-wrap items-center gap-3 py-10`}
        action="#"
        onsubmit="return false"
      >
        <i class="fa-solid fa-magnifying-glass text-sound-navy text-3xl"></i>
        <input
          type="search"
          value={query}
          class="font-display text-40 border-sound-navy min-w-0 flex-1 border-b-4 bg-transparent px-2 py-2 focus:outline-none"
        />
        <select
          class="border-sound-navy rounded border-2 bg-transparent px-2 py-2"
        >
          <option>Any tag</option>
          {allTags.map((t) => <option>{t}</option>)}
        </select>
        <button
          class="bg-sound-navy text-cedar-cream font-display rounded px-5 py-2"
          >Go</button
        >
      </form>
    </div>
    <div class={`${wrap} py-10`}>
      <p class="font-display text-sound-navy text-2xl">
        {results.length} results
      </p>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          results.map((p) => (
            <article class="ring-sound-navy/10 rounded-lg bg-white p-5 shadow-sm ring-1">
              <div class="flex flex-wrap gap-2">
                {p.tags.map((t) => (
                  <span class={chip}>{t}</span>
                ))}
              </div>
              <h3 class="font-display text-sound-navy mt-3 mb-2 text-2xl">
                {p.title}
              </h3>
              <p class="m-0 text-sm">
                {p.author.name} · {p.minutes} min
              </p>
            </article>
          ))
        }
      </div>

      <p class="text-sound-navy/50 mt-16 text-xs tracking-widest uppercase">
        Empty state ↓
      </p>
      <div class="bg-sound-navy text-cedar-cream rounded-lg p-12 text-center">
        <i class="fa-solid fa-ghost text-madrona-yellow text-6xl"></i>
        <h2 class="font-display text-cedar-cream text-40">Nothing here… yet</h2>
        <p>No posts match “webassembly”. Pitch us one?</p>
        <a
          href="#"
          class="bg-madrona-yellow text-sound-navy font-display inline-block rounded px-5 py-2 no-underline"
          >Back to the blog</a
        >
      </div>
    </div>
  </section>

  {/* ───────────── POST ───────────── */}
  <section data-view="post">
    <div data-progress class="bg-sound-navy/10 sticky top-0 z-40 h-2">
      <div data-progress-fill class="bg-madrona-yellow h-full w-0"></div>
    </div>
    <article>
      <header class="bg-sound-navy text-cedar-cream">
        <div class={`${wrap} pt-14 pb-40`}>
          <div class="flex flex-wrap gap-2">
            {
              post.tags.map((t) => (
                <a href="#" class={chip}>
                  {t}
                </a>
              ))
            }
          </div>
          <h1
            class="font-display text-cedar-cream mt-5 mb-6 max-w-[18ch] text-[80px] leading-none"
          >
            {post.title}
          </h1>
          <div class="flex items-center gap-4">
            <Image
              src={post.author.image}
              alt=""
              width={128}
              class="ring-madrona-yellow size-16 rounded-full object-cover ring-4"
            />
            <div>
              <a href="#" class="text-cedar-cream text-xl font-medium"
                >{post.author.name}</a
              >
              <div class="text-cedar-cream/70 text-sm">
                {fmtDate(post.pubDate)} · {post.minutes} min read
              </div>
            </div>
          </div>
        </div>
      </header>
      {
        post.image && (
          <div class={`${wrap} -mt-32`}>
            <Image
              src={post.image}
              alt=""
              width={1400}
              class="aspect-[2/1] w-full rounded-lg object-cover shadow-xl"
            />
          </div>
        )
      }
      <div
        class={`${wrap} grid gap-10 py-12 md:grid-cols-[64px_minmax(0,720px)]`}
      >
        <aside class="hidden md:block">
          <div class="sticky top-8 flex flex-col gap-3">
            {
              shares.map((s) => (
                <a
                  href={s.href}
                  target="_blank"
                  aria-label={`Share on ${s.label}`}
                  class="bg-sound-navy text-cedar-cream hover:bg-cascade-blue flex size-12 items-center justify-center rounded-full text-xl"
                >
                  <i class={s.icon} />
                </a>
              ))
            }
            <button
              aria-label="Copy link"
              class="bg-sound-navy text-cedar-cream hover:bg-cascade-blue flex size-12 items-center justify-center rounded-full text-xl"
              ><i class="fa-solid fa-link"></i></button
            >
            <button
              aria-label="Share"
              class="bg-madrona-yellow text-sound-navy flex size-12 items-center justify-center rounded-full text-xl"
              ><i class="fa-solid fa-arrow-up-from-bracket"></i></button
            >
          </div>
        </aside>
        <div class="text-xl">
          <PostBody codeTheme="night-owl" />
          {/* Mobile: share bar fixed to the bottom of the viewport */}
          <div
            class="bg-sound-navy fixed inset-x-0 bottom-16 z-30 flex justify-around py-2 md:hidden"
          >
            {
              shares.map((s) => (
                <a href={s.href} class="text-cedar-cream text-xl">
                  <i class={s.icon} />
                </a>
              ))
            }
            <button class="text-cedar-cream text-xl"
              ><i class="fa-solid fa-link"></i></button
            >
          </div>
        </div>
      </div>
    </article>
  </section>

  {/* ───────────── TAG ───────────── */}
  <section data-view="tag">
    <div class="bg-sound-navy">
      <div class={`${wrap} py-14`}>
        <span
          class="bg-mint text-sound-navy font-display rounded-full px-6 py-2 text-[56px] leading-none"
          >#{tag}</span
        >
        <p class="text-cedar-cream mt-6 mb-0 text-xl">
          {tagged.length} posts tagged {tag}
        </p>
      </div>
    </div>
    <div class={`${wrap} grid gap-6 py-12 sm:grid-cols-2 lg:grid-cols-3`}>
      {
        tagged.map((p) => (
          <article class="ring-sound-navy/10 overflow-hidden rounded-lg bg-white shadow-sm ring-1">
            {p.image ? (
              <Image
                src={p.image}
                alt=""
                width={600}
                class="aspect-[16/10] w-full object-cover"
              />
            ) : (
              <div class="bg-cascade-blue aspect-[16/10]" />
            )}
            <h3 class="font-display text-sound-navy m-0 p-5 text-2xl">
              {p.title}
            </h3>
          </article>
        ))
      }
    </div>
  </section>

  {/* ───────────── AUTHOR ───────────── */}
  <section data-view="author">
    <div class="bg-sound-navy text-cedar-cream">
      <div class={`${wrap} py-14 text-center`}>
        <Image
          src={author.image}
          alt={`photo of ${author.name}`}
          width={400}
          class="ring-madrona-yellow mx-auto size-48 rounded-full object-cover ring-8"
        />
        <h1
          class="font-display text-cedar-cream mt-6 mb-1 text-[72px] leading-none"
        >
          {author.name}
        </h1>
        <p class="text-madrona-yellow m-0 text-xl">{author.pronouns}</p>
        <p class="text-cedar-cream/90 mt-3 text-xl">
          {author.title} @ {author.company} · <i
            class="fa-solid fa-location-dot"></i>
          {author.location}
        </p>
        <p class="text-cedar-cream mx-auto max-w-[55ch]">{author.bio}</p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a
            href={author.url}
            class="bg-madrona-yellow text-sound-navy rounded-full px-4 py-2 font-medium no-underline"
            ><i class="fa-solid fa-globe"></i> Website</a
          >
          {
            author.social.map((s) => (
              <a
                href={s.url}
                class="bg-cedar-cream text-sound-navy flex size-10 items-center justify-center rounded-full text-xl no-underline"
                aria-label={s.type}
              >
                <i class={`fa-brands fa-${s.type}`} />
              </a>
            ))
          }
        </div>
      </div>
    </div>
    <div class={`${wrap} grid gap-6 py-12 sm:grid-cols-2 lg:grid-cols-3`}>
      {
        byAuthor.map((p) => (
          <article class="ring-sound-navy/10 overflow-hidden rounded-lg bg-white shadow-sm ring-1">
            {p.image ? (
              <Image
                src={p.image}
                alt=""
                width={600}
                class="aspect-[16/10] w-full object-cover"
              />
            ) : (
              <div class="bg-cascade-blue aspect-[16/10]" />
            )}
            <h3 class="font-display text-sound-navy m-0 p-5 text-2xl">
              {p.title}
            </h3>
          </article>
        ))
      }
    </div>
  </section>
</div>
