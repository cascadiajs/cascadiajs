---
import type { Talk } from "@shared/data/types";

interface Props {
  talk: Talk;
  /** URL prefix of the Talk pages, with no trailing slash. */
  talksBase: string;
  /** Omitted after the first Talk in a run -- row still reserves the time column. */
  when?: string;
}

const { talk, when, talksBase } = Astro.props;
---

<div class="cjs-talk-item m-4 flex">
  <div class="cjs-time-cell mr-4">{when}</div>
  <div class="flex-1">
    {
      talk.type === "keynote" && (
        <div class="cjs-keynote-badge bg-emerald-city-green text-sound-navy mb-2 inline-block rounded px-2 py-0.5 text-sm">
          Keynote
        </div>
      )
    }
    <div class="text-sound-navy text-22 font-serif leading-tight font-light">
      {
        talk.slug ? (
          <a
            href={`${talksBase}/${talk.slug}`}
            class="text-sound-navy hover:text-cascade-blue no-underline hover:underline"
          >
            {talk.title}
          </a>
        ) : (
          talk.title
        )
      }
    </div>
    <div class="leading-normal">{talk.speaker.name}</div>
  </div>
</div>
