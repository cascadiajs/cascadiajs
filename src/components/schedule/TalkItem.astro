---
/**
 * A Talk row within the Main Track, looked up by the Talk's own `id`.
 * Renders through `TalkRow`, which has the same time-cell + content shape as
 * `ShowItem` (not built from it -- a Talk's content, keynote badge + Speaker
 * name, doesn't fit ShowItem's schema), so Track's time-cell override reaches
 * this row too. A Talk with no `slug` renders its title as plain text, not a
 * dead link.
 */
import { getEntry } from "astro:content";
import TalkRow from "./TalkRow.astro";

interface Props {
  /** A Talk's `id` -- looked up from the roster, never passed literally. */
  talk: string;
  /** Omitted after the first Talk in a run -- row still reserves the time column. */
  when?: string;
}

const { talk: talkId, when } = Astro.props;

const entry = await getEntry("talks2026", talkId);
if (!entry) {
  throw new Error(`No Talk found with id "${talkId}"`);
}
---

<TalkRow talk={entry.data} when={when} talksBase="/2026/talks" />
