<div class="prose-content">
  <slot />
</div>

<style>
  /*
   * Scoped <style> exception (ADR-0003 / ADR-0007).
   *
   * Everything styled below (h2/h3, a, li, ul, .styled-table, #toc) is
   * generated directly from markdown prose that the page author writes as
   * plain Markdown -- they have no way to attach a Tailwind utility class to
   * it. ADR-0003's exception clause reserves scoped <style> for exactly this
   * case: a CSS construct that Tailwind utilities cannot reach. Do NOT use
   * this as precedent for styling ordinary components whose markup you
   * control -- use Tailwind utility classes there, per ADR-0003's default.
   *
   * MarkdownContent is a pure prose wrapper (issue #63): it no longer owns
   * any page structure (that's SimplePage's job) and wraps its slot in its
   * own `.prose-content` div so these rules are self-contained regardless of
   * what parent structure the component is rendered inside.
   *
   * Astro scoped styles do not pierce slotted content, so every rule below
   * that targets a markdown-generated element inside .prose-content uses
   * :global(...) to actually reach it in the rendered DOM.
   */

  /* Markdown prose headings can't carry a Tailwind class, so their
     font-sizes -- previously dead-code duplicates in the global @layer base
     h1/h2/h3 rules -- are scoped here instead, alongside the rest of the
     markdown-specific styling this block already owns (ADR-0007). */
  .prose-content :global(h2) {
    font-size: 32px;
  }

  .prose-content :global(h3) {
    font-size: 24px;
  }

  /* Tailwind's preflight also zeroes all margin/padding via a universal
     selector and strips list-style globally (`ol,ul,menu{list-style:none}`).
     The legacy stylesheet has no such reset, so a plain markdown <ul> there
     renders with full browser UA defaults (disc bullets, 40px indent,
     block margins) -- only `.toc` lists are deliberately unstyled. `revert`
     restores those UA defaults for ordinary lists; the more specific `.toc`
     rules below still win over this lower-specificity selector. */
  .prose-content :global(ul) {
    list-style: revert;
    margin: revert;
    padding-inline-start: revert;
  }

  .prose-content :global(li) {
    padding: 4px;
  }

  .prose-content :global(ul > li) {
    line-height: 1.5em;
  }

  .prose-content :global(a:not(.no-underline)),
  .prose-content :global(a:visited:not(.no-underline)) {
    color: var(--color-cascade-blue, #0033ff);
    text-decoration: underline;
  }

  /* .strike marks an outdated date/value inline within prose that flows
     through this component's slot (e.g. a superseded deadline next to its
     replacement). Scoped here alongside the rest of this block rather than
     as a Tailwind utility in the markup, matching how the other inline
     prose rules above (a, .styled-table, #toc) are handled. */
  .prose-content :global(.strike) {
    text-decoration: line-through;
  }

  /* MDX wraps a CtaButton label in a <p>. The link carries .cta so this
     flattens that paragraph without touching other prose. */
  .prose-content :global(.cta > p) {
    display: inline;
    margin: 0;
    line-height: inherit;
  }

  .prose-content :global(.styled-table) {
    border-collapse: collapse;
    margin: 25px 0;
    font-size: 18px;

    /* max-width: 343px; */
  }

  .prose-content :global(.styled-table thead tr) {
    color: #112378;
    text-align: left;
  }

  .prose-content :global(.styled-table th),
  .prose-content :global(.styled-table td) {
    padding: 12px 15px;
  }

  .prose-content :global(.styled-table thead tr),
  .prose-content :global(.styled-table tbody tr) {
    border-bottom: #cfd3e4 1px solid;
  }

  .prose-content :global(.styled-table th) {
    font-family: freight-macro-pro, serif;
    font-weight: 500;
    font-style: normal;
  }

  .prose-content :global(.styled-table tbody tr.passed) {
    color: #ccc;
  }

  .prose-content :global(.styled-table tbody tr.active-row) {
    font-weight: bold;
    color: #009879;
  }

  .prose-content :global(#toc) {
    margin-bottom: 16px;
  }

  .prose-content :global(#toc h2) {
    font-family: "mono45-headline", sans-serif;
    font-weight: 200;
    font-size: 18px;
    text-decoration: underline;
  }

  .prose-content :global(#toc a),
  .prose-content :global(#toc a:visited) {
    font-weight: 700;
    text-decoration: none;
  }

  .prose-content :global(#toc a:hover) {
    text-decoration: underline;
  }

  .prose-content :global(#toc ul) {
    padding-inline-start: 0;
  }

  .prose-content :global(#toc li) {
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
