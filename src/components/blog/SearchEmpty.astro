---
/** The empty state of a blog search with no results. */
---

<div
  class="cjs-search-empty bg-sound-navy text-cedar-cream rounded-lg p-12 text-center"
>
  <i class="fa-solid fa-ghost text-madrona-yellow text-6xl" aria-hidden="true"
  ></i>
  <h2 class="font-display text-cedar-cream text-40">No Posts match</h2>
  <p>Try fewer words, or browse every Post.</p>
  <a
    href="/blog"
    class="bg-madrona-yellow text-sound-navy font-display inline-block rounded px-5 py-2 no-underline"
  >
    Back to the blog
  </a>
</div>
