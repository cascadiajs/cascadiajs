---
import type { CollectionEntry } from "astro:content";
import FeaturedCard from "@components/blog/FeaturedCard.astro";

interface Props {
  /** Up to three Featured Posts, newest first. */
  posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;
---

{
  posts.length > 0 && (
    <section class="cjs-featured-band bg-sound-navy text-cedar-cream">
      <div class="mx-auto box-content max-w-[1200px] px-4 pb-12">
        <div class="grid gap-4 md:grid-cols-3">
          {posts.map((post) => (
            <FeaturedCard post={post} />
          ))}
        </div>
      </div>
    </section>
  )
}
