---
import Layout from "./Layout.astro";
import SimplePage from "./SimplePage.astro";
import MarkdownContent from "@components/MarkdownContent.astro";
import SponsorsGrid from "@components/SponsorsGrid.astro";
import CtaButton from "@components/CtaButton.astro";
import Testimonials from "@components/Testimonials.astro";
import { DEFAULT_TITLE, FEATURED_EVENT } from "@shared/site-defaults";

interface Props {
  title: string;
  description?: string;
  width?: "narrow" | "wide";
  showSponsors?: boolean;
  showTestimonials?: boolean;
  ogImage?: string;
  displayAlert?: boolean;
}

const {
  title,
  description,
  width = "narrow",
  showSponsors = true,
  showTestimonials = true,
  ogImage,
  displayAlert = true,
} = Astro.props;
const metaTitle = title ? `CascadiaJS | ${title}` : DEFAULT_TITLE;
---

<Layout
  title={metaTitle}
  description={description ?? metaTitle}
  ogImage={ogImage}
  displayAlert={displayAlert}
>
  <SimplePage title={title} width={width}>
    <MarkdownContent>
      <slot />
    </MarkdownContent>
    <Fragment slot="after-body">
      {
        showSponsors && (
          <section id="sponsors" class="box-content p-8 text-center">
            <h2 class="font-display mt-0 mb-8 text-5xl">Past Sponsors</h2>
            <SponsorsGrid exclude={FEATURED_EVENT} />
            <CtaButton href={`/${FEATURED_EVENT}/sponsor`}>
              Sponsor Our Event
            </CtaButton>
          </section>
        )
      }
      {showTestimonials && <Testimonials />}
    </Fragment>
  </SimplePage>
</Layout>
