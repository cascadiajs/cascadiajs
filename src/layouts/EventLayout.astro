---
import { getEventConfig } from "@shared/data/events";
import type { EventYear } from "@shared/data/types";
import Layout from "./Layout.astro";
import EventNav from "@components/EventNav.astro";

interface Props {
  /** Event Key of the Event this page belongs to; always a four-digit year. */
  year: EventYear;
  title: string;
  description?: string;
  ogImage?: string;
  displayAlert?: boolean;
}

const { year, title, description, ogImage, displayAlert = true } = Astro.props;

const config = getEventConfig(year);
---

<Layout
  title={title}
  description={description ?? config.ogDescription}
  ogImage={ogImage ?? config.ogImage}
  displayNav={false}
  displayAlert={displayAlert}
>
  <slot name="hero" />
  <EventNav year={config.year} logo={config.logo} nav={config.nav} />
  <slot />
</Layout>
