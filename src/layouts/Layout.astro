---
import "../styles/global.css";
import SiteHeader from "@components/SiteHeader.astro";
import SiteFooter from "@components/SiteFooter.astro";
import {
  DEFAULT_DESCRIPTION,
  DEFAULT_TITLE,
  GA4_ID,
  META_PIXEL_ID,
} from "@shared/site-defaults";
import { routePath } from "@shared/route-path";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  displayNav?: boolean;
  displayAlert?: boolean;
  /** Set on an article page (a blog Post): switches `og:type` to article. */
  article?: {
    publishedTime: Date;
    modifiedTime?: Date;
    /** Author names, in byline order. */
    authors: string[];
    tags: string[];
  };
}

const {
  description = DEFAULT_DESCRIPTION,
  displayNav = true,
  displayAlert = true,
  ogImage = "/images/2026/share/social-sharing-general.png",
  title = DEFAULT_TITLE,
  article,
} = Astro.props;

// Legacy snippets, verbatim from app/head.mjs. Kept as strings so the braces
// in them aren't parsed as template expressions.
const GTAG_CONFIG = `
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', '${GA4_ID}');
`;
const META_PIXEL = `
!function(f,b,e,v,n,t,s)
{if(f.fbq)return;n=f.fbq=function(){n.callMethod?
n.callMethod.apply(n,arguments):n.queue.push(arguments)};
if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
n.queue=[];t=b.createElement(e);t.async=!0;
t.src=v;s=b.getElementsByTagName(e)[0];
s.parentNode.insertBefore(t,s)}(window, document,'script',
'https://connect.facebook.net/en_US/fbevents.js');
fbq('init', '${META_PIXEL_ID}');
fbq('track', 'PageView');
`;
const META_PIXEL_NOSCRIPT = ` <img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=${META_PIXEL_ID}&ev=PageView&noscript=1"> `;
const origin = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(routePath(Astro.url), origin).href;
const ogImageUrl = new URL(ogImage, origin).href;

const buildInfo = {
  version: "local",
  buildId: "local",
  buildContext: "local",
};
if (import.meta.env.NETLIFY) {
  buildInfo.version = import.meta.env.COMMIT_REF;
  buildInfo.buildId = import.meta.env.BUILD_ID;
  buildInfo.buildContext = import.meta.env.CONTEXT;
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script
      is:inline
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>
    <script is:inline set:html={GTAG_CONFIG} />
    <script is:inline set:html={META_PIXEL} />
    <meta name="version" content={buildInfo.version} />
    <meta name="build-id" content={buildInfo.buildId} />
    <meta name="build-context" content={buildInfo.buildContext} />

    <meta name="author" content="CascadiaJS" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={article ? "article" : "website"} />
    {
      article && (
        <>
          <meta
            property="article:published_time"
            content={article.publishedTime.toISOString()}
          />
          {article.modifiedTime && (
            <meta
              property="article:modified_time"
              content={article.modifiedTime.toISOString()}
            />
          )}
          {article.authors.map((name) => (
            <meta property="article:author" content={name} />
          ))}
          {article.tags.map((tag) => (
            <meta property="article:tag" content={tag} />
          ))}
        </>
      )
    }

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:site" content="@cascadiajs" />

    <!-- Fonts: Adobe Typekit -->
    <link rel="stylesheet" href="https://use.typekit.net/nln6hzq.css" />

    <!-- Icons: Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
    {
      /* Paid-tier glyphs (fa-taco, etc.) not in the free CDN stylesheet
         above. `is:inline` emits the tag verbatim instead of bundling it. */
    }
    <script
      is:inline
      src="https://kit.fontawesome.com/95fd764ad0.js"
      crossorigin="anonymous"
      async></script>
  </head>
  <!-- grid-cols-[100%] avoids the implicit `auto` column sizing to
       max-content, which would let an overwide section (2026 pricing row)
       stretch the whole grid. -->
  <body
    class="bg-seafoam-cream md:grid md:min-h-screen md:grid-cols-[100%] md:grid-rows-[auto_1fr_auto]"
  >
    <SiteHeader displayNav={displayNav} displayAlert={displayAlert} />

    <main class="text-lg font-extralight">
      <slot />
    </main>

    <SiteFooter />
    <noscript set:html={META_PIXEL_NOSCRIPT} />
  </body>
</html>
